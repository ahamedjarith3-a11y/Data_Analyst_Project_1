table MonthlyRevenue
	lineageTag: d8e88f21-7c5a-4736-870c-3c10f2c86039

	column Month
		dataType: string
		lineageTag: e6480d22-6da5-49b5-969b-0bf66f6b1a6b
		summarizeBy: none
		sourceColumn: Month

	column USD_Revenue
		dataType: double
		formatString: \$#,##0
		lineageTag: cccf5a90-7372-4118-abcc-43b0cc47031f
		summarizeBy: sum
		sourceColumn: USD_Revenue

	partition MonthlyRevenue = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\monthly_revenue.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    ChangedType = Table.TransformColumnTypes(PromotedHeaders, {
				            {"Month", type text},
				            {"USD_Revenue", type number}
				    }, "en-US")
				in
				    ChangedType

