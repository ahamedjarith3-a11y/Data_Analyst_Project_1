table ReconciledTransactions

    column Date
        dataType: dateTime
        sourceColumn: Date

    column User_ID
        dataType: string
        sourceColumn: User_ID

    column Product_ID
        dataType: string
        sourceColumn: Product_ID

    column Euro_Value
        dataType: double
        sourceColumn: Euro_Value

    column EUR_to_USD_Filled
        dataType: double
        sourceColumn: EUR_to_USD_Filled

    column USD_Revenue
        dataType: double
        sourceColumn: USD_Revenue

    column Month
        dataType: string
        sourceColumn: Month

    column name
        dataType: string
        sourceColumn: name

    measure Total USD Revenue = SUM(ReconciledTransactions[USD_Revenue])
        formatString: \$#,##0.00

    measure Transaction Count = COUNTROWS(ReconciledTransactions)
        formatString: #,##0

    measure Average Transaction USD = DIVIDE([Total USD Revenue], [Transaction Count])
        formatString: \$#,##0.00

    partition ReconciledTransactions = m
        mode: import
        source =
            let
                Source = Csv.Document(
                    File.Contents("C:\Enterprise_Data_Reconciliation\data\reconciled_transactions.csv"),
                    [Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]
                ),
                PromotedHeaders = Table.PromoteHeaders(
                    Source,
                    [PromoteAllScalars=true]
                ),
                ChangedType = Table.TransformColumnTypes(
                    PromotedHeaders,
                    {
                        {"Date", type datetime},
                        {"User_ID", type text},
                        {"Product_ID", type text},
                        {"Euro_Value", type number},
                        {"EUR_to_USD_Filled", type number},
                        {"USD_Revenue", type number},
                        {"Month", type text},
                        {"name", type text}
                    }
                )
            in
                ChangedType
