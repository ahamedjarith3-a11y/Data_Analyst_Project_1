{
  "name": "Harbor Light",
  "dataColors": [
    "#2563EB",
    "#0E9F9A",
    "#F59E0B",
    "#E5604F",
    "#7C6BD6",
    "#94A3B8",
    "#2BB3E0",
    "#8FB339"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2A44",
  "tableAccent": "#2563EB",
  "good": "#0E9F9A",
  "neutral": "#F59E0B",
  "bad": "#E5604F",
  "textClasses": {
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#64748B"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#1F2A44"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#1F2A44"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#1F2A44"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E8F0"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#C7CFDD"
              }
            },
            "position": "Outer",
            "preset": "BottomRight",
            "transparency": 85,
            "shadowBlur": 6,
            "angle": 45,
            "shadowDistance": 2
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1F2A44"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 13,
            "alignment": "left"
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10,
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 10,
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#E6EAF2"
              }
            },
            "gridlineShow": true
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 12,
            "right": 12
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1F2A44"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F9"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E6EAF2"
              }
            },
            "rowPadding": 5
          }
        ],
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#EEF2F9"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#1F2A44"
              }
            },
            "bold": true,
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontSize": 10,
            "fontColorPrimary": {
              "solid": {
                "color": "#1F2A44"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F8FAFD"
              }
            }
          }
        ]
      }
    }
  }
}